<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below. allowBackup="false" already turns backup off there; this
    states the same thing explicitly so the two rule files cannot disagree.
    Android 12+ reads data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
