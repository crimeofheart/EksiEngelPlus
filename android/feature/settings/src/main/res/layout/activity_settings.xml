<?xml version="1.0" encoding="utf-8"?>
<!--
    One switch per extension option, grouped the way the extension groups them,
    so a user who knows one client can find the same setting in the other.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_group_action"
            android:textStyle="bold" android:textSize="13sp"
            android:letterSpacing="0.08"
            android:paddingTop="20dp" android:paddingBottom="6dp"
            android:alpha="0.75"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMute"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_mute"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_mute_hint"
            android:textSize="12sp" android:alpha="0.6"
            android:paddingBottom="6dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchTitleBan"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_title_ban"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_title_hint"
            android:textSize="12sp" android:alpha="0.6"
            android:paddingBottom="6dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_group_scope"
            android:textStyle="bold" android:textSize="13sp"
            android:letterSpacing="0.08"
            android:paddingTop="20dp" android:paddingBottom="6dp"
            android:alpha="0.75"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchNoobBan"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_noob_ban"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_noob_hint"
            android:textSize="12sp" android:alpha="0.6"
            android:paddingBottom="6dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchProtectFollowed"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_protect_followed"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_protect_hint"
            android:textSize="12sp" android:alpha="0.6"
            android:paddingBottom="6dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchOnlyRequired"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_only_required"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_only_required_hint"
            android:textSize="12sp" android:alpha="0.6"
            android:paddingBottom="6dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAnalysis"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_analysis"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_analysis_hint"
            android:textSize="12sp" android:alpha="0.6"
            android:paddingBottom="6dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_group_appearance"
            android:textStyle="bold" android:textSize="13sp"
            android:letterSpacing="0.08"
            android:paddingTop="20dp" android:paddingBottom="6dp"
            android:alpha="0.75"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPremiumIcons"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_premium_icons"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAppPromo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_app_promo"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchBlockAds"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_block_ads"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_block_ads_hint"
            android:textSize="12sp" android:alpha="0.6"
            android:paddingBottom="6dp"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_group_filter"
            android:textStyle="bold" android:textSize="13sp"
            android:letterSpacing="0.08"
            android:paddingTop="20dp" android:paddingBottom="6dp"
            android:alpha="0.75"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDateFilter"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_date_filter"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_date_filter_hint"
            android:textSize="12sp" android:alpha="0.6"
            android:paddingBottom="6dp"/>

        <!-- Rules live under their toggle and are hidden with it: editing rules
             that nothing consults would only invite the question why. -->
        <LinearLayout
            android:id="@+id/rulesSection"
            android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/rulesList"
                android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/rulesEmpty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/settings_rules_empty"
                android:textSize="13sp" android:alpha="0.6"
                android:paddingTop="8dp" android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/rulesAdd"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_rules_add"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_group_telemetry"
            android:textStyle="bold" android:textSize="13sp"
            android:letterSpacing="0.08"
            android:paddingTop="20dp" android:paddingBottom="6dp"
            android:alpha="0.75"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSendData"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_send_data"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSendLog"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:text="@string/settings_send_log"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_group_storage"
            android:textStyle="bold" android:textSize="13sp"
            android:letterSpacing="0.08"
            android:paddingTop="20dp" android:paddingBottom="6dp"
            android:alpha="0.75"/>

        <TextView
            android:id="@+id/cacheStats"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingTop="4dp" android:paddingBottom="2dp"
            android:text="@string/settings_storage_loading"/>

        <TextView
            android:id="@+id/dbStats"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingBottom="8dp"
            android:text="@string/settings_storage_loading"/>

        <Button
            android:id="@+id/clearCache"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_clear_cache"/>

        <Button
            android:id="@+id/clearData"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_clear_data"/>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_group_help"
            android:textStyle="bold" android:textSize="13sp"
            android:letterSpacing="0.08"
            android:paddingTop="20dp" android:paddingBottom="6dp"
            android:alpha="0.75"/>

        <!-- The guide is not here. It sits in the browser's top bar next to
             ayarlar, which is where a user looking for help looks first, and one
             destination with two doors is worse than one with one. -->
        <Button
            android:id="@+id/openReleaseNotes"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_open_release_notes"/>

    </LinearLayout>
</ScrollView>
