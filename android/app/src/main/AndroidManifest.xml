<?xml version="1.0" encoding="utf-8"?>
<!--
    Placeholder shell for the release pipeline. No launcher activity, no application
    code: this module exists so `v*` tags provably produce an AAB and APK before the
    real port (android-foundations) starts. See openspec/changes/unified-release-pipeline.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".EksiEngelPlusApp"
        android:allowBackup="false"
        android:label="EksiEngelPlus"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">
        <activity android:name=".BrowserActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!--
                Offers this app as a destination for Ekşi links. Deliberately NOT
                autoVerify: hijacking every link would be presumptuous, and the
                user should get a chooser rather than have it decided for them.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="eksisozluk.com"/>
                <data android:scheme="https" android:host="*.eksisozluk.com"/>
            </intent-filter>
        </activity>
    </application>

</manifest>
