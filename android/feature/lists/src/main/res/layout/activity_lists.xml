<?xml version="1.0" encoding="utf-8"?>
<!--
    One card per concern, in the order notification.html uses them. Every card
    carries the same header, padding and divider, so the screen reads as one
    thing rather than as the sum of what was added last.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView android:id="@+id/listsNotice"
            style="@style/EksiEngel.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="13sp"
            android:background="#ffd166" android:textColor="#000000"
            android:text="@string/lists_operation_running"/>

        <LinearLayout style="@style/EksiEngel.Card" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <TextView style="@style/EksiEngel.CardTitle" android:text="@string/section_lists"/>

            <include android:id="@+id/rowBlocked" layout="@layout/view_list_row"/>
            <include android:id="@+id/rowMuted" layout="@layout/view_list_row"/>
            <include android:id="@+id/rowFollowed" layout="@layout/view_list_row"/>
            <include android:id="@+id/rowTitleBanned" layout="@layout/view_list_row"/>
        </LinearLayout>

        <LinearLayout style="@style/EksiEngel.Card" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <TextView style="@style/EksiEngel.CardTitle" android:text="@string/bulk_title"/>

            <TextView style="@style/EksiEngel.CardHint" android:text="@string/bulk_hint"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/openBulk"
                style="@style/Widget.EksiEngel.Button.Primary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/bulk_open"/>
        </LinearLayout>

        <LinearLayout style="@style/EksiEngel.Card" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <TextView style="@style/EksiEngel.CardTitle" android:text="@string/author_list_title"/>

            <TextView android:id="@+id/authorSummary"
                style="@style/EksiEngel.CardHint"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/openAuthorList"
                style="@style/Widget.EksiEngel.Button.Primary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/author_list_open"/>
        </LinearLayout>

        <LinearLayout style="@style/EksiEngel.Card" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <TextView style="@style/EksiEngel.CardTitle" android:text="@string/ops_title"/>

            <TextView android:id="@+id/opsSummary" style="@style/EksiEngel.CardHint"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/openOperations"
                style="@style/Widget.EksiEngel.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ops_open"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
