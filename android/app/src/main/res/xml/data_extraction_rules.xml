<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ replacement for allowBackup="false", which those versions no longer
    honour for device-to-device transfer. Nothing is backed up or transferred: the
    device key behind history sync must never be cloned onto a second device, and
    every list the app stores can be fetched again from Ekşi Sözlük.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
