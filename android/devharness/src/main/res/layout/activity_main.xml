<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <WebView android:id="@+id/web"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView android:id="@+id/status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="4dp" android:textSize="10sp" android:maxLines="1"
        android:text="idle"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="4dp">
        <Button android:id="@+id/btnLogin" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Login" android:textSize="11sp"/>
        <Button android:id="@+id/btnHome" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Home" android:textSize="11sp"/>
        <Button android:id="@+id/btnChecks" android:layout_width="0dp" android:layout_weight="1.4"
            android:layout_height="wrap_content" android:text="Run checks" android:textSize="11sp"/>
        <Button android:id="@+id/btnShare" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Share" android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="4dp">
        <EditText android:id="@+id/target" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:hint="target nick you control"
            android:textSize="12sp" android:inputType="text" android:autofillHints=""/>
        <Button android:id="@+id/btnMutate" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Mutation test" android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="4dp">
        <Button android:id="@+id/btnEngine" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Engine dry run" android:textSize="11sp"/>
        <Button android:id="@+id/btnEngineReal" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Engine REAL (block+undo)" android:textSize="11sp"/>
    </LinearLayout>

    <ScrollView android:id="@+id/scroll"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3">
        <TextView android:id="@+id/results"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:textSize="10sp"
            android:fontFamily="monospace" android:textIsSelectable="true"/>
    </ScrollView>
</LinearLayout>
