<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The green of the resume bar, so the two surfaces read as one app. -->
    <color name="eksi_accent">#81C14B</color>
    <color name="eksi_on_accent">#000000</color>

    <!--
        Action groups keep red / amber / green, taken from the extension's own
        notification palette so the two clients name the same thing the same way.
        Used as stroke and label on outlined buttons, which is what lets one value
        work on both the light and dark dialog surfaces.
    -->
    <color name="action_block">#EF4444</color>
    <color name="action_mute">#F59E0B</color>
    <color name="action_follow">#45A049</color>
</resources>
