<?xml version="1.0" encoding="utf-8"?>
<!--
    Approximates the extension's button language: square, outlined in 2dp,
    uppercase with wide tracking (buttons.css uses border-radius 0, a 2px solid
    border, text-transform uppercase and 3px letter-spacing).

    Material's rounded pills read as a different product next to the extension,
    which is the thing these two are supposed to feel like halves of.

    No textAllCaps. The platform uppercases with the default locale, and Turkish
    maps i to İ, so labels rendered as IŞLEM and TEMIZLE. The app's voice is
    lowercase throughout anyway, which is also how Ekşi writes.
-->
<resources>
    <style name="Widget.EksiEngel.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">0dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/eksi_accent</item>
        <item name="android:textColor">@color/eksi_accent</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!--
        For two-up rows where the label is long. "takipten çıkar" is the widest
        of them and wrapped to a second line, which left that one button a
        different height from its pair.

        Material's own insets plus the tracking cost most of the width here, so
        both come down rather than the text size, which would make one row read
        smaller than the rest.
    -->
    <style name="Widget.EksiEngel.Button.Compact" parent="Widget.EksiEngel.Button">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:maxLines">1</item>
        <!-- Four of these share a row; the longest label decides the width, and
             clipping it would be worse than shrinking all four together. -->
        <item name="android:ellipsize">none</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">9sp</item>
        <item name="autoSizeMaxTextSize">12sp</item>
        <!-- A shared floor, so a button whose text autosized smaller does not end
             up shorter than the ones beside it. -->
        <item name="android:minHeight">46dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- The green bar's colours, for the action a screen is actually for. -->
    <style name="Widget.EksiEngel.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">0dp</item>
        <item name="backgroundTint">@color/eksi_accent</item>
        <item name="android:textColor">@color/eksi_on_accent</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- One card shape everywhere, so sections stop inventing their own. -->
    <style name="EksiEngel.Card" parent="">
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <style name="EksiEngel.CardTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:alpha">0.8</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="EksiEngel.CardHint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:alpha">0.6</item>
    </style>
</resources>
