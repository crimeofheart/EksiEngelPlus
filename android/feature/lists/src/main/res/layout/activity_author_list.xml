<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView android:id="@+id/authorCount"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="14sp"/>

        <ProgressBar android:id="@+id/authorSpinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- The paste field is the common case: the extension's page is a textarea and
         users move lists around as plain text far more often than as files. -->
    <EditText android:id="@+id/authorText"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:importantForAutofill="no"
        android:textSize="14sp"
        android:hint="@string/author_list_hint"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton android:id="@+id/authorSave"
            style="@style/Widget.EksiEngel.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/author_list_save"/>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton android:id="@+id/authorImport"
            style="@style/Widget.EksiEngel.Button"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/author_list_import"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/authorClear"
            style="@style/Widget.EksiEngel.Button"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/author_list_clear"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton android:id="@+id/authorRun"
        style="@style/Widget.EksiEngel.Button.Primary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/author_list_run"/>
</LinearLayout>
