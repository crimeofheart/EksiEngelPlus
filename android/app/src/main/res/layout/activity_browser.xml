<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView android:id="@+id/sessionBar"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:padding="6dp" android:textSize="12sp" android:text="…"/>

        <!-- The only way into the lists and the author list. The theme has no
             action bar, so the entry point lives in the layout. -->
        <TextView android:id="@+id/listsEntry"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="10dp" android:textSize="12sp"
            android:background="?android:attr/selectableItemBackground"
            android:text="@string/open_lists"/>
    </LinearLayout>

    <!-- Hidden until a session appears with a run parked on PAUSED_AUTH. An offer,
         so it is tapped rather than acted on by itself. -->
    <TextView android:id="@+id/resumeBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="10dp" android:textSize="13sp"
        android:visibility="gone"
        android:background="#81c14b" android:textColor="#000000"
        android:text="@string/resume_paused_operation"/>

    <WebView android:id="@+id/web"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
